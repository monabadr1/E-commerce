@page "/category/{categoryId:int}"

@using Shared
@using FrontEnd.Consumer

@inject ProductConsumer productConsumer
@inject NavigationManager Nav

<div class="container py-5">
    @if (products == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border custom-spinner mb-2"></div>
            <p class="text-muted small">Loading products...</p>
        </div>
    }
    else if (!products.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5">
            <i class="bi bi-bag-x fs-1 text-muted"></i>
            <h3 class="mt-3 fw-bold text-theme">No Products Found</h3>
            <p class="text-muted">There are currently no products in this category.</p>
        </div>
    }
    else
    {
        <div class="mb-4 text-start">
            <h2 class="fw-bold mb-2 text-capitalize page-main-title">
                @(products.FirstOrDefault()?.CategoryName ?? "Products")
            </h2>
        </div>

        <div class="row g-4 g-md-4">
            @foreach (var item in products)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card product-card border-0 shadow-sm w-100 overflow-hidden d-flex flex-column position-relative"
                         style="cursor: pointer;"
                         @onclick="() => GoToDetails(item.ProductId)">

                        <div class="position-relative overflow-hidden bg-light" style="height: 290px;">
                            @if (item.DiscountPercentage > 0)
                            {
                                <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-2.5 py-1.5 rounded-pill shadow-sm" style="z-index: 5;">
                                    -@item.DiscountPercentage% OFF
                                </span>
                            }

                            <img src="@(item.Images?.FirstOrDefault() ?? "images/no-image.png")"
                                 class="card-img-top product-image"
                                 style="object-fit: cover; object-position: top center; width: 100%; height: 100%;" />
                        </div>

                        <div class="card-body d-flex flex-column justify-content-between p-4 flex-grow-1">
                            <div>
                                <h5 class="fw-bold text-theme mb-2 text-truncate">@item.Name</h5>

                                <div class="d-flex align-items-center gap-2">
                                    @if (item.DiscountPercentage > 0)
                                    {
                                        <h4 class="fw-bold text-black mb-0">@item.Price.ToString("F2") EGP</h4>
                                        <span class="text-muted text-decoration-line-through small">@item.OriginalPrice EGP</span>
                                    }
                                    else
                                    {
                                        <h4 class="fw-bold text-theme-dark mb-0">@item.Price EGP</h4>
                                    }
                                </div>
                            </div>

                            <button class="btn btn-theme w-100 mt-4 py-2">
                                <i class="bi bi-eye me-2"></i>View Details
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int categoryId { get; set; }
    private List<ProductDto>? products;

    protected override async Task OnParametersSetAsync()
    {
        products = await productConsumer.GetproductByCategoryIdAsync(categoryId);
    }

    void GoToDetails(int id) => Nav.NavigateTo($"/productdetails/{id}");
}