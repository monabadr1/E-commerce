@page "/favorite"

@using Shared
@using Service
@using Microsoft.AspNetCore.Components.Web
@using FrontEnd.Consumer
@inject WishListConsumer wishListConsumer
@inject FavoriteStateService favoriteStateService
@inject NavigationManager nav
@inject AuthenticationStateProvider AuthStateProvider

<div class="container py-5">
    <h2 class="fw-bold mb-4 page-main-title">
        My WishList
    </h2>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border custom-spinner"></div>
        </div>
    }
    else if ((isLoggedIn && (wishList == null || !wishList.wishListItems.Any())) || (!isLoggedIn && !favoriteItems.Any()))
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <i class="bi bi-heart fs-1 text-muted"></i>
            <h3 class="mt-3 fw-bold text-theme">Your wishlist is empty</h3>
            <p class="text-muted">Add products you love and they will appear here.</p>
        </div>
    }
    else
    {
        <div class="row g-4 g-md-4">
            @if (isLoggedIn && wishList != null)
            {
                @foreach (var item in wishList.wishListItems)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="card product-card border-0 shadow-sm h-100 overflow-hidden rounded-3">

                            <div class="position-relative overflow-hidden bg-light" style="height: 290px;">
                                @if (item.OriginalPrice > item.Price)
                                {
                                    <span class="badge bg-danger position-absolute top-0 start-0 m-2 px-2 py-1 shadow-sm" style="z-index: 5;">
                                        SALE
                                    </span>
                                }
                                <img src="@item.ImageUrl" class="w-100 h-100"
                                     style="object-fit: cover; object-position: top center;" alt="@item.ProductName" />
                            </div>

                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between align-items-center gap-2">
                                        <h6 class="fw-bold text-theme mb-0 text-truncate" style="max-width: 80%;">@item.ProductName</h6>
                                        <button class="btn p-0 border-0 bg-transparent flex-shrink-0" @onclick="() => RemoveItem(item.WishListItemId)">
                                            <i class="bi bi-heart-fill text-danger fs-6"></i>
                                        </button>
                                    </div>
                                    <p class="text-muted extra-small mt-1 mb-0" style="font-size: 0.8rem;">Premium Fashion Product</p>
                                </div>

                                <div class="mt-auto pt-2">
                                    <div class="d-flex align-items-baseline gap-2 mb-2">
                                        <h5 class="fw-bold text-theme-dark mb-0" style="font-size: 1.1rem;">@item.Price.ToString("F2") EGP</h5>
                                        @if (item.OriginalPrice > item.Price)
                                        {
                                            <span class="text-muted text-decoration-line-through extra-small" style="font-size: 0.8rem;">@item.OriginalPrice EGP</span>
                                        }
                                    </div>
                                    <button class="btn btn-theme w-100 py-1.5 rounded-2 fw-semibold btn-sm" @onclick="() => NavigateToDetails(item.ProductId)">
                                        View Product
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                @foreach (var item in favoriteItems)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="card product-card border-0 shadow-sm h-100 overflow-hidden rounded-3">

                            <div class="position-relative overflow-hidden bg-light" style="height: 290px;">
                                <!-- 🏷️ Sale Badge (Local Guest Wishlist) -->
                                @if (item.OriginalPrice > item.Price)
                                {
                                    <span class="badge bg-danger position-absolute top-0 start-0 m-2 px-2 py-1 shadow-sm" style="z-index: 5;">
                                        SALE
                                    </span>
                                }
                                <img src="@item.ImageUrl" class="w-100 h-100"
                                     style="object-fit: cover; object-position: top center;" alt="@item.ProductName" />
                            </div>

                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between align-items-center gap-2">
                                        <h6 class="fw-bold text-theme mb-0 text-truncate" style="max-width: 80%;">@item.ProductName</h6>
                                        <button class="btn p-0 border-0 bg-transparent flex-shrink-0" @onclick="() => RemoveLocalItem(item.ProductId)">
                                            <i class="bi bi-heart-fill text-danger fs-6"></i>
                                        </button>
                                    </div>
                                    <p class="text-muted extra-small mt-1 mb-0" style="font-size: 0.8rem;">Premium Fashion Product</p>
                                </div>

                                <div class="mt-auto pt-2">
                                    <!-- 💰 Price Section -->
                                    <div class="d-flex align-items-baseline gap-2 mb-2">
                                        <h5 class="fw-bold text-theme-dark mb-0" style="font-size: 1.1rem;">@item.Price.ToString("F2") EGP</h5>
                                        @if (item.OriginalPrice > item.Price)
                                        {
                                            <span class="text-muted text-decoration-line-through extra-small" style="font-size: 0.8rem;">@item.OriginalPrice EGP</span>
                                        }
                                    </div>
                                    <button class="btn btn-theme w-100 py-1.5 rounded-2 fw-semibold btn-sm" @onclick="() => NavigateToDetails(item.ProductId)">
                                        View Product
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    List<FavoriteItemDto> favoriteItems = new();
    private WishListDto? wishList;
    private bool isLoggedIn;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isLoggedIn = authState.User.Identity?.IsAuthenticated ?? false;
        await Loadwishlist();
        isLoading = false;
    }

    private void NavigateToDetails(int productId)
    {
        nav.NavigateTo($"/productdetails/{productId}");
    }

    async Task RemoveItem(int wishlistItemId)
    {
        await wishListConsumer.DeletItemWishListAsync(wishlistItemId);
        await Loadwishlist();
    }

    async Task RemoveLocalItem(int productVariantId)
    {
        await favoriteStateService.RemoveFromFavoriteAsync(productVariantId);
        favoriteItems = await favoriteStateService.GetFavoriteAsync();
    }

    private async Task Loadwishlist()
    {
        if (isLoggedIn)
        {
            try
            {
                wishList = await wishListConsumer.GetWishListByUserIdAsync();
            }
            catch
            {
                wishList = new WishListDto { wishListItems = new List<WishListItemDto>() };
            }
        }
        else
        {
            favoriteItems = await favoriteStateService.GetFavoriteAsync();
        }
    }
}