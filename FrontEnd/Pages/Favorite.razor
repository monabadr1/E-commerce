@page "/favorite"

@using Shared
@using Service
@using Microsoft.AspNetCore.Components.Web
@using FrontEnd.Consumer
@inject WishListConsumer wishListConsumer
@inject FavoriteStateService favoriteStateService
@inject NavigationManager nav
@inject AuthenticationStateProvider AuthStateProvider


<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-5">

        <div>
            <h1 class="fw-bold display-5 mb-1">
                My Wishlist ❤️
            </h1>

            <p class="text-muted">
                Your favorite products in one place
            </p>
        </div>

    </div>

    @if (favoriteItems == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-dark"></div>
        </div>
    }
    else if (!favoriteItems.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">

            <i class="bi bi-heart fs-1 text-danger"></i>

            <h3 class="mt-3">
                Your wishlist is empty
            </h3>

            <p class="text-muted">
                Add products you love and they will appear here.
            </p>

        </div>
    }
    else
    {
        <div class="row g-4">

            @if (isLoggedIn && wishList!=null)
            {
                @foreach (var item in wishList.wishListItems)
                {
                    <div class="col-lg-3">

                        <div class="card favorite-card border-0 shadow">

                            <img src="@item.ImageUrl"
                                 class="favorite-image" />

                            <div class="card-body p-4">

                                <div class="d-flex justify-content-between align-items-start">

                                    <div>

                                        <h3 class="fw-bold mb-2">
                                            @item.ProductName
                                        </h3>

                                        <p class="text-muted mb-0">
                                            Premium Fashion Product
                                        </p>

                                    </div>

                                    <button class="btn btn-link text-danger p-0"
                                            @onclick="() => RemoveItem(item.WishListItemId)">

                                        <i class="bi bi-heart-fill fs-3"></i>

                                    </button>

                                </div>

                                <div class="mt-4">

                                    <h4 class="fw-bold">
                                        @item.Price EGP
                                    </h4>

                                </div>

                                <div class="mt-4">

                                    <button class="btn btn-dark w-100">
                                        View Product
                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                @foreach (var item in favoriteItems)
                {
                    <div class="col-lg-3">

                        <div class="card favorite-card border-0 shadow">

                            <img src="@item.ImageUrl"
                                 class="favorite-image" />

                            <div class="card-body p-4">

                                <div class="d-flex justify-content-between align-items-start">

                                    <div>

                                        <h3 class="fw-bold mb-2">
                                            @item.ProductName
                                        </h3>

                                        <p class="text-muted mb-0">
                                            Premium Fashion Product
                                        </p>

                                    </div>

                                    <button class="btn btn-link text-danger p-0"
                                            @onclick="() => RemoveLocalItem(item.ProductVariantId)">

                                        <i class="bi bi-heart-fill fs-3"></i>

                                    </button>

                                </div>

                                <div class="mt-4">

                                    <h4 class="fw-bold">
                                        @item.Price EGP
                                    </h4>

                                </div>

                                <div class="mt-4">

                                    <button class="btn btn-dark w-100">
                                        View Product
                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }


        </div>
    }

</div>

@code {

    List<FavoriteItemDto> favoriteItems = new();
    private WishListDto? wishList;

    private bool isLoggedIn;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isLoggedIn = authState.User.Identity?.IsAuthenticated ?? false; await Loadwishlist();
        isLoading = false;
    }
    async Task RemoveItem(int wishlistItemId)
    {
        await wishListConsumer.DeletItemWishListAsync(wishlistItemId);
        await Loadwishlist();
    }

    async Task RemoveLocalItem(int productVariantId)
    {
        await favoriteStateService.RemoveFromFavoriteAsync(productVariantId);

        favoriteItems = await favoriteStateService.GetFavoriteAsync();
    }


    private async Task Loadwishlist()
    {
        if (isLoggedIn)
        {
            try
            {
                wishList = await wishListConsumer.GetWishListByUserIdAsync();
            }
            catch
            {
                wishList = new WishListDto
                {
                    wishListItems = new List<WishListItemDto>()
                };
            }
        }
        else
        {
            favoriteItems = await favoriteStateService.GetFavoriteAsync();
        }
    }
}