@page "/account"

@using FrontEnd.Consumer
@using FrontEnd.Service
@using Shared
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject AuthConsumer AuthConsumer
@inject CartStateService CartState
@inject FavoriteStateService favoriteState
@inject CartConsumer CartConsumer
@inject WishListConsumer wishListConsumer
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<div class="login-container">
    <div class="login-card">
        <h2>Welcome Back</h2>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger border-0 small mb-3">
                @errorMessage
            </div>
        }

        <EditForm Model="@model" OnValidSubmit="sign_up">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <InputText @bind-Value="model.Email"
                           placeholder="Email"
                           class="form-control"
                           type="email" />
                <ValidationMessage For="@(() => model.Email)" class="text-danger small mt-1 d-block" />
            </div>

            <div class="mb-3">
                <InputText @bind-Value="model.Password"
                           type="password"
                           placeholder="Password"
                           class="form-control" />
                <ValidationMessage For="@(() => model.Password)" class="text-danger small mt-1 d-block" />
            </div>

            <button type="submit" class="btn btn-theme w-100 fw-bold mt-2" disabled="@isProcessing">
                @if (isProcessing)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Logging in...</span>
                }
                else
                {
                    <span>Login</span>
                }
            </button>
        </EditForm>

        <p class="mt-3 text-center small text-muted">
            Don't have an account?
            <a href="/register" class="text-theme fw-bold text-decoration-none">Register</a>
        </p>
    </div>
</div>

@code {
    LoginDto model = new();
    private bool isProcessing = false;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            RedirectUserBasedOnRole(user);
        }
    }

    async Task sign_up()
    {
        isProcessing = true;
        errorMessage = "";

        try
        {
            var response = await AuthConsumer.LoginAsync(model);

            if (response != null)
            {
                await ((CustomAuthStateProvider)AuthStateProvider).MarkUserAsAuthenticate(response.Token);

                var localCartItems = await CartState.GetCartAsync();
                var favoriteItems = await favoriteState.GetFavoriteAsync();

                if (localCartItems != null && localCartItems.Any())
                {
                    await CartConsumer.SyncCartAsync(localCartItems);
                    await CartState.ClearCartAsync();
                }

                if (favoriteItems != null && favoriteItems.Any())
                {
                    await wishListConsumer.SyncWishListAsync(favoriteItems);
                    await favoriteState.ClearFavoriteAsync();
                }

                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                RedirectUserBasedOnRole(authState.User);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void RedirectUserBasedOnRole(ClaimsPrincipal user)
    {
        if (user.IsInRole("Admin") || user.HasClaim(ClaimTypes.Role, "Admin"))
        {
            Nav.NavigateTo("/admin/dashboard");
        }
        else
        {
            Nav.NavigateTo("/profile");
        }
    }
}