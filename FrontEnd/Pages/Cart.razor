@page "/cart"

@using Shared
@using FrontEnd.Consumer
@using FrontEnd.Service
@using Microsoft.AspNetCore.Components.Web
@inject CartConsumer cartConsumer
@inject CartStateService CartState
@inject NavigationManager nav
@inject AuthenticationStateProvider AuthStateProvider

<div class="container py-5">
    <h2 class="fw-bold mb-4 page-main-title">Shopping cart</h2>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border custom-spinner"></div>
        </div>
    }
    else if ((isLoggedIn && (cart == null || cart.Items == null || !cart.Items.Any()))
          || (!isLoggedIn && (localCart == null || !localCart.Any())))
    {
        <div class="card border-0 shadow-sm text-center p-5 rounded-4">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <h4 class="mt-3 fw-bold text-theme">Your cart is empty</h4>
            <p class="text-muted">Add some products and come back.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                @if (isLoggedIn && cart?.Items != null)
                {
                    @foreach (var item in cart.Items)
                    {
                        <div class="card border-0 shadow-sm rounded-4 mb-3 overflow-hidden position-relative">
                            <div class="row g-0">
                                <div class="col-md-3 col-4 position-relative">
                                    @if (item.OriginalPrice > item.Price)
                                    {
                                        <span class="badge bg-danger position-absolute top-0 start-0 m-2 px-2 py-1 shadow-sm" style="z-index:2; font-size: 0.75rem;">
                                            SALE
                                        </span>
                                    }
                                    <img src="@(item.ImageUrl ?? "images/no-image.png")"
                                         class="img-fluid h-100 w-100"
                                         style="object-fit:cover; min-height:160px;" />
                                </div>

                                <div class="col-md-9 col-8">
                                    <div class="card-body p-3 p-md-4 d-flex flex-column justify-content-between h-100 position-relative">
                                        <div>
                                            <div class="d-flex justify-content-between align-items-start pe-4">
                                                <h5 class="fw-bold text-theme mb-2" style="font-size: 1.25rem;">@item.ProductName</h5>
                                            </div>

                                            <button class="btn btn-sm btn-outline-danger border-0 position-absolute top-0 end-0 m-3"
                                                    @onclick="() => RemoveItem(item)"
                                                    title="Remove item">
                                                <i class="bi bi-trash fs-5"></i>
                                            </button>

                                            <div class="d-flex flex-wrap gap-2 mb-3">
                                                <span class="badge bg-light text-dark border px-3 py-2 fs-6 fw-normal">
                                                    Color: <strong class="text-capitalize">@item.Color</strong>
                                                </span>
                                                <span class="badge bg-light text-dark border px-3 py-2 fs-6 fw-normal">
                                                    Size: <strong class="text-uppercase">@item.Size</strong>
                                                </span>
                                            </div>

                                            <div class="d-flex align-items-baseline gap-2">
                                                <h5 class="fw-bold text-theme-dark mb-0 fs-4">@item.Price.ToString("F2") EGP</h5>
                                                @if (item.OriginalPrice > item.Price)
                                                {
                                                    <span class="text-muted text-decoration-line-through small">@item.OriginalPrice.ToString("N2") EGP</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-2 mt-3">
                                            <button class="btn btn-outline-theme-increment" @onclick="() => Decrease(item)">-</button>
                                            <span class="fw-bold px-3 fs-6 text-theme">@item.Quantity</span>
                                            <button class="btn btn-outline-theme-increment" @onclick="() => Increase(item)">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else if (localCart != null)
                {
                    @foreach (var item in localCart)
                    {
                        <div class="card border-0 shadow-sm rounded-4 mb-3 overflow-hidden position-relative">
                            <div class="row g-0">
                                <div class="col-md-3 col-4 position-relative">
                                    @if (item.OriginalPrice > item.Price)
                                    {
                                        <span class="badge bg-danger position-absolute top-0 start-0 m-2 px-2 py-1 shadow-sm" style="z-index:2; font-size: 0.75rem;">
                                            SALE
                                        </span>
                                    }
                                    <img src="@(item.ImageUrl ?? "images/no-image.png")"
                                         class="img-fluid h-100 w-100"
                                         style="object-fit:cover; min-height:160px;" />
                                </div>

                                <div class="col-md-9 col-8">
                                    <div class="card-body p-3 p-md-4 d-flex flex-column justify-content-between h-100 position-relative">
                                        <div>
                                            <div class="d-flex justify-content-between align-items-start pe-4">
                                                <h5 class="fw-bold text-theme mb-2" style="font-size: 1.25rem;">@item.ProductName</h5>
                                            </div>

                                            <button class="btn btn-sm btn-outline-danger border-0 position-absolute top-0 end-0 m-3"
                                                    @onclick="() => RemoveLocalItem(item.ProductVariantId)"
                                                    title="Remove item">
                                                <i class="bi bi-trash fs-5"></i>
                                            </button>

                                            <div class="d-flex flex-wrap gap-2 mb-3">
                                                <span class="badge bg-light text-theme border px-3 py-2 fs-6 fw-normal">
                                                    Color: <strong class="text-capitalize">@item.Color</strong>
                                                </span>
                                                <span class="badge bg-light text-theme border px-3 py-2 fs-6 fw-normal">
                                                    Size: <strong class="text-uppercase">@item.Size</strong>
                                                </span>
                                            </div>

                                            <div class="d-flex align-items-baseline gap-2">
                                                <h5 class="fw-bold text-theme-dark mb-0 fs-4">@item.Price.ToString("N2") EGP</h5>
                                                @if (item.OriginalPrice > item.Price)
                                                {
                                                    <span class="text-muted text-decoration-line-through small">@item.OriginalPrice.ToString("N2") EGP</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-2 mt-3">
                                            <button class="btn btn-outline-theme-increment" @onclick="() => DecreaseLocal(item)">-</button>
                                            <span class="fw-bold px-3 fs-6 text-theme">@item.Quantity</span>
                                            <button class="btn btn-outline-theme-increment" @onclick="() => IncreaseLocal(item)">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Summary Section -->
            <div class="col-lg-4">
                <div class="card border-0 shadow rounded-4 p-3">
                    <div class="card-body">
                        <h4 class="fw-bold mb-4 text-theme">Order Summary</h4>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-muted">Total Amount</span>
                            <span class="fw-bold fs-4 text-theme">@GetTotal().ToString("N2") EGP</span>
                        </div>

                        @if (showLoginWarning)
                        {
                            <div class="alert alert-warning alert-dismissible fade show p-2 mb-3 small" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                Please <a href="/login" class="fw-bold text-dark text-decoration-underline">Login</a> first to proceed with checkout.
                                <button type="button" class="btn-close p-2" @onclick="() => showLoginWarning = false"></button>
                            </div>
                        }

                        <hr class="my-4" style="color: var(--theme-border);" />
                        <button class="btn btn-theme w-100 py-2.5 fw-bold shadow-sm rounded-3" @onclick="Checkout">
                            Proceed To Checkout
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private CartDto? cart;
    private List<LocalCartItemDto> localCart = new();

    private bool isLoggedIn;
    private bool isLoading = true;
    private bool showLoginWarning = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isLoggedIn = authState.User.Identity?.IsAuthenticated ?? false;
        await LoadCart();
        isLoading = false;
    }

    private async Task LoadCart()
    {
        if (isLoggedIn)
        {
            cart = await cartConsumer.GetCartAsync();
        }
        else
        {
            localCart = await CartState.GetCartAsync() ?? new List<LocalCartItemDto>();
        }
    }

    private async Task Increase(CartItemDto item)
    {
        await cartConsumer.UpdateQuantityAsync(new UpdateCartItemDto
        {
            CartItemId = item.CartItemId,
            Quantity = item.Quantity + 1
        });
        await LoadCart();
    }

    private async Task Decrease(CartItemDto item)
    {
        if (item.Quantity <= 1) return;

        await cartConsumer.UpdateQuantityAsync(new UpdateCartItemDto
        {
            CartItemId = item.CartItemId,
            Quantity = item.Quantity - 1
        });
        await LoadCart();
    }

    private async Task RemoveItem(CartItemDto item)
    {
        await cartConsumer.RemoveCartItemAsync(item.CartItemId);
        await LoadCart();
    }

    private async Task IncreaseLocal(LocalCartItemDto item)
    {
        item.Quantity++;
        await CartState.UpdateQuantityAsync(item.ProductVariantId, item.Quantity);
        await LoadCart();
    }

    private async Task DecreaseLocal(LocalCartItemDto item)
    {
        if (item.Quantity <= 1) return;

        item.Quantity--;
        await CartState.UpdateQuantityAsync(item.ProductVariantId, item.Quantity);
        await LoadCart();
    }

    private async Task RemoveLocalItem(int productVariantId)
    {
        await CartState.RemoveItemAsync(productVariantId);
        await LoadCart();
    }

    private void Checkout()
    {
        if (!isLoggedIn)
        {
            showLoginWarning = true;
            return;
        }

        nav.NavigateTo("/checkout");
    }

    private decimal GetTotal()
    {
        if (isLoggedIn)
        {
            return cart?.Items?.Sum(x => x.Price * x.Quantity) ?? 0;
        }

        return localCart?.Sum(x => x.Price * x.Quantity) ?? 0;
    }
}