@page "/sale"

@using Shared
@using FrontEnd.Consumer

@inject ProductConsumer productConsumer
@inject CategoryConsumer categoryConsumer
@inject NavigationManager Nav

<div class="container py-5">

    <div class="text-center mb-5">
        <span class="badge bg-danger px-3 py-2 text-uppercase rounded-pill mb-2">Exclusive Deals</span>
        <h2 class="fw-bold display-5 text-theme">Special Sale & Offers</h2>
        <p class="text-muted">Discover all discounted items in one place</p>
    </div>

    <div class="d-flex justify-content-center flex-wrap gap-2 mb-4">
        <button class="btn @(selectedMainCatId == 0 ? "btn-theme shadow-sm" : "btn-custom-beige") rounded-pill px-4 py-2 fw-bold"
                @onclick="() => FilterByMainCategory(0)">
            All Sale Items
        </button>

        @if (mainCategories != null)
        {
            @foreach (var cat in mainCategories)
            {
                <button class="btn @(selectedMainCatId == cat.CategoryId ? "btn-theme shadow-sm" : "btn-custom-beige") rounded-pill px-4 py-2 fw-bold"
                        @onclick="() => FilterByMainCategory(cat.CategoryId)">
                    @cat.Name
                </button>
            }
        }
    </div>

    @if (selectedMainCatId > 0 && subCategories != null && subCategories.Any())
    {
        <div class="d-flex justify-content-center flex-wrap gap-2 mb-5 p-3 bg-light rounded-4 border animate__animated animate__fadeIn">
            <span class="align-self-center text-muted me-2 small fw-bold">Subcategories:</span>
            <button class="btn btn-sm @(selectedSubCatId == 0 ? "btn-theme" : "btn-custom-beige") rounded-pill px-3"
                    @onclick="() => FilterBySubCategory(0)">
                All
            </button>
            @foreach (var sub in subCategories)
            {
                <button class="btn btn-sm @(selectedSubCatId == sub.CategoryId ? "btn-theme" : "btn-custom-beige") rounded-pill px-3"
                        @onclick="() => FilterBySubCategory(sub.CategoryId)">
                    @sub.Name
                </button>
            }
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border custom-spinner mb-2"></div>
            <p class="text-muted small">Loading sale items...</p>
        </div>
    }
    else if (filteredSaleProducts == null || !filteredSaleProducts.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5 rounded-4 my-4">
            <i class="bi bi-tag-fill fs-1 text-muted mb-2"></i>
            <h4 class="fw-bold text-theme">No Sale Products Available</h4>
            <p class="text-muted mb-0">There are currently no discounted items in this category.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in filteredSaleProducts)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card product-card border-0 shadow-sm h-100 overflow-hidden position-relative"
                         style="cursor: pointer;"
                         @onclick="() => GoToDetails(item.ProductId)">

                        <div class="position-relative overflow-hidden bg-light" style="height: 290px;">
                            <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-2.5 py-1.5 rounded-pill shadow-sm" style="z-index: 5;">
                                -@item.DiscountPercentage% OFF
                            </span>
                            <img src="@(item.Images?.FirstOrDefault() ?? "images/no-image.png")"
                                 class="card-img-top product-image"
                                 style="object-fit: cover; object-position: top center; width: 100%; height: 100%;" />
                        </div>

                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                            <div class="mb-2">
                                <h6 class="fw-bold text-theme mb-1 text-truncate">@item.Name</h6>
                                <span class="badge bg-light text-muted border small mb-2">@item.CategoryName</span>

                                <div class="d-flex align-items-center gap-2 mt-1">
                                    <h5 class="fw-bold text-black mb-0">@item.Price.ToString("F2") EGP </h5>
                                    <span class="text-muted text-decoration-line-through small">@item.OriginalPrice EGP</span>
                                </div>
                            </div>

                            <button class="btn btn-theme w-100 py-1.5 rounded-2 fw-semibold btn-sm mt-2">
                                View Details
                            </button>
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>

@code {
    private List<ProductDto>? allSaleProducts;
    private List<ProductDto>? filteredSaleProducts;
    private List<CategoryDto>? mainCategories;
    private List<CategoryDto>? subCategories;

    private int selectedMainCatId = 0;
    private int selectedSubCatId = 0;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            mainCategories = (await categoryConsumer.GetMainCategoryAsync()).ToList();

            var allProducts = await productConsumer.GetProductAsync();
            allSaleProducts = allProducts?.Where(p => p.DiscountPercentage > 0).ToList() ?? new List<ProductDto>();

            ApplyFilters();
        }
        catch
        {
            allSaleProducts = new List<ProductDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task FilterByMainCategory(int mainCatId)
    {
        selectedMainCatId = mainCatId;
        selectedSubCatId = 0;
        subCategories = new List<CategoryDto>();

        if (selectedMainCatId > 0)
        {
            try
            {
                subCategories = (await categoryConsumer.GetSubCategoryAsync(selectedMainCatId)).ToList();
            }
            catch { }
        }

        ApplyFilters();
    }

    private void FilterBySubCategory(int subCatId)
    {
        selectedSubCatId = subCatId;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (allSaleProducts == null) return;

        var query = allSaleProducts.AsEnumerable();

        if (selectedMainCatId > 0)
        {
            var validCategoryIds = new List<int> { selectedMainCatId };

            if (subCategories != null && subCategories.Any())
            {
                validCategoryIds.AddRange(subCategories.Select(s => s.CategoryId));
            }

            query = query.Where(p => validCategoryIds.Contains(p.CategoryId));
        }

        if (selectedSubCatId > 0)
        {
            query = query.Where(p => p.CategoryId == selectedSubCatId);
        }

        filteredSaleProducts = query.ToList();
    }

    private void GoToDetails(int productId) => Nav.NavigateTo($"/productdetails/{productId}");
}