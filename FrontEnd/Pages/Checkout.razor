@page "/checkout"

@using Shared
@using FrontEnd.Consumer
@using FrontEnd.Service
@using Microsoft.AspNetCore.Components.Forms
@using System.Security.Claims

@inject CartConsumer cartConsumer
@inject CheckOutConsumer checkOutConsumer
@inject NavigationManager nav
@inject AuthenticationStateProvider AuthStateProvider

<div class="container py-5" style="max-width: 950px;">
    <h2 class="fw-bold mb-4 text-theme">Checkout Details</h2>

    @if (isProcessing)
    {
        <div class="text-center py-5">
            <div class="spinner-border custom-spinner mb-3"></div>
            <p class="text-muted fw-semibold">Processing your order, please wait...</p>
        </div>
    }
    else if (orderSuccess)
    {
        <div class="card border-0 shadow-sm text-center p-5 rounded-4">
            <i class="bi bi-check-circle-fill text-success display-1"></i>
            <h3 class="mt-4 fw-bold text-theme">Thank You For Your Order!</h3>
            <p class="text-muted max-w-md mx-auto">Your order has been placed successfully and registered in our database.</p>
            <button class="btn btn-theme px-4 py-2 mt-3 rounded-3 fw-bold shadow-sm" @onclick="NavigateToHome">
                Continue Shopping
            </button>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-4 text-theme"><i class="bi bi-geo-alt me-2"></i>Shipping & Contact Info</h5>

                    <EditForm Model="@checkoutModel" OnValidSubmit="HandleCheckout">
                        <DataAnnotationsValidator />

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger border-0 rounded-3 small mb-3">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Full Name</label>
                            <input type="text" class="form-control py-2 rounded-3 border-light-subtle" @bind="customerName" placeholder="Your full name" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Email Address</label>
                            <input type="email" class="form-control py-2 rounded-3 border-light-subtle" @bind="customerEmail" placeholder="name@example.com" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Phone Number</label>
                            <InputText class="form-control py-2 rounded-3 border-light-subtle" @bind-Value="checkoutModel.Phone" placeholder="e.g. 01xxxxxxxxx" />
                            <ValidationMessage For="@(() => checkoutModel.Phone)" class="text-danger small mt-1" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">City</label>
                            <InputText class="form-control py-2 rounded-3 border-light-subtle" @bind-Value="checkoutModel.City" placeholder="e.g. Cairo" />
                            <ValidationMessage For="@(() => checkoutModel.City)" class="text-danger small mt-1" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Full Address</label>
                            <InputTextArea class="form-control py-2 rounded-3 border-light-subtle" @bind-Value="checkoutModel.Address" rows="3" placeholder="Street name, Building number..." />
                            <ValidationMessage For="@(() => checkoutModel.Address)" class="text-danger small mt-1" />
                        </div>
                        <div class="mb-4">
                            <h5 class="fw-bold mb-3 text-theme"><i class="bi bi-credit-card me-2"></i>Payment Method</h5>

                                <InputRadioGroup @bind-Value="checkoutModel.PaymentMethod">
                                    <div class="card p-3 mb-2 border rounded-3 bg-white shadow-sm hover-card" style="cursor: pointer;">
                                        <div class="form-check d-flex align-items-center gap-2 mb-0">
                                            <InputRadio Value="@("CashOnDelivery")" class="form-check-input" id="cod" />
                                            <label class="form-check-label fw-semibold text-dark mb-0 d-flex align-items-center gap-2 w-100" for="cod">
                                                <i class="bi bi-cash-stack text-success fs-5"></i>
                                                <span>Cash on Delivery (COD)</span>
                                            </label>
                                        </div>
                                    </div>

                                    <!-- Option 2: Credit Card -->
                                    <div class="card p-3 border rounded-3 bg-white shadow-sm hover-card" style="cursor: pointer;">
                                        <div class="form-check d-flex align-items-center gap-2 mb-0">
                                            <InputRadio Value="@("CreditCard")" class="form-check-input" id="card" />
                                            <label class="form-check-label fw-semibold text-dark mb-0 d-flex align-items-center gap-2 w-100" for="card">
                                                <i class="bi bi-credit-card-2-front text-primary fs-5"></i>
                                                <span>Credit / Debit Card</span>
                                            </label>
                                        </div>
                                    </div>
                                </InputRadioGroup>

                                <!-- تحذير يظهر فقط لما يختار الكارت -->
                                @if (checkoutModel.PaymentMethod == "CreditCard")
                                {
                                    <div class="alert alert-warning border-0 rounded-3 small mt-2 mb-0 d-flex align-items-center gap-2">
                                        <i class="bi bi-exclamation-triangle-fill text-warning fs-6"></i>
                                        <span>Credit/Debit card payment is currently not available. Please select Cash on Delivery.</span>
                                    </div>
                                }

                                <ValidationMessage For="@(() => checkoutModel.PaymentMethod)" class="text-danger small mt-1" />

                            <ValidationMessage For="@(() => checkoutModel.PaymentMethod)" class="text-danger small mt-1" />
                        </div>

                        <button type="submit" class="btn btn-theme w-100 py-2.5 rounded-3 fw-bold shadow-sm mt-3">
                            Confirm Order (@totalPrice EGP)
                        </button>
                    </EditForm>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-light-subtle">

                    <div class="d-flex justify-content-between align-items-center mb-3"
                         style="cursor: pointer; user-select: none;"
                         @onclick="ToggleSummary">
                        <h5 class="fw-bold text-theme mb-0">
                            <i class="bi bi-bag-check me-2"></i>Order Summary
                        </h5>
                        <div>
                            <span class="badge bg-secondary-subtle text-dark me-2">@cartItems.Count Items</span>
                            <i class="bi @(showSummary ? "bi-chevron-up" : "bi-chevron-down") text-muted"></i>
                        </div>
                    </div>

                    @if (showSummary)
                    {
                        <div class="overflow-y-auto mb-3 animate__animated animate__fadeIn" style="max-height: 300px;">
                            @foreach (var item in cartItems)
                            {
                                <div class="d-flex gap-3 align-items-center mb-3 pb-3 border-bottom border-light">
                                    <img src="@item.ImageUrl" class="rounded-3 border bg-white" style="width: 60px; height: 60px; object-fit: cover;" />
                                    <div class="flex-grow-1 min-w-0">
                                        <h6 class="mb-0 fw-bold text-theme text-truncate">@item.ProductName</h6>
                                        <small class="text-muted d-block">Size: @item.Size | Qty: @item.Quantity</small>
                                        <span class="small fw-semibold text-theme-dark">@item.Price EGP</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top border-light">
                        <span class="text-muted small fw-bold">Grand Total</span>
                        <span class="fw-bold fs-4 text-theme-dark">@totalPrice EGP</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private CheckoutDto checkoutModel = new();
    private List<CartItemDto> cartItems = new();
    private decimal totalPrice = 0;
    private int currentUserId;

    private string customerName = "";
    private string customerEmail = "";

    private bool showSummary = true;

    private bool isProcessing = false;
    private bool orderSuccess = false;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            nav.NavigateTo("/login?returnUrl=/checkout");
            return;
        }

        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier) ?? user.FindFirst("sub");
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int id))
        {
            currentUserId = id;

            customerName = user.Identity.Name ?? "";
            customerEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? "";
        }
        else
        {
            errorMessage = "User identity context block is missing.";
            return;
        }

        try
        {
            var cart = await cartConsumer.GetCartAsync();
            if (cart != null && cart.Items.Any())
            {
                cartItems = cart.Items.ToList();
                totalPrice = cartItems.Sum(x => x.Price * x.Quantity);
            }
            else
            {
                nav.NavigateTo("/cart");
            }
        }
        catch (Exception)
        {
            errorMessage = "Failed to synchronize checkout sequence.";
        }
    }

    private void ToggleSummary()
    {
        showSummary = !showSummary;
    }

    private async Task HandleCheckout()
    {
        isProcessing = true;
        errorMessage = "";

        try
        {
            await checkOutConsumer.CheckoutAsync(currentUserId, checkoutModel);
            orderSuccess = true;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void NavigateToHome() => nav.NavigateTo("/");
}