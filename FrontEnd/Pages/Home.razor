@page "/"

@using FrontEnd.Consumer

@inject ProductConsumer productConsumer
@inject CategoryConsumer categoryConsumer
@inject NavigationManager Nav

<!-- Hero Section -->

<section class="hero-section">

    
    <div class="container">

        <div class="row align-items-center min-vh-75">

            <div class="col-lg-6">

                <span class="badge bg-dark px-3 py-2 mb-3">
                    New Collection 2026
                </span>

                <h1 class="display-2 fw-bold mb-4">
                    Discover Your
                    Perfect Style
                </h1>

                <p class="lead text-secondary mb-4">
                    Explore premium fashion collections for Women,
                    Men and Kids with the latest trends and best prices.
                </p>

                <div class="d-flex gap-3 flex-wrap">

                    <button class="btn btn-dark btn-lg px-5"
                            @onclick="GoToCategories">

                        Shop Now

                    </button>

                </div>

            </div>

            <div class="col-lg-6 text-center">

                <img src="images/modelwoman.jpg"
                     class="img-fluid hero-image shadow-lg" />

            </div>

        </div>

    </div>
    

</section>

<!-- Features -->

<section class="py-5 bg-light">

    
    <div class="container">

        <div class="row g-4">

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100 text-center">

                    <div class="card-body p-4">

                        <i class="bi bi-truck fs-1 text-dark"></i>

                        <h4 class="mt-3">
                            Free Shipping
                        </h4>

                        <p class="text-muted">
                            Free delivery for orders over 2500 EGP
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100 text-center">

                    <div class="card-body p-4">

                        <i class="bi bi-credit-card fs-1 text-dark"></i>

                        <h4 class="mt-3">
                            Secure Payment
                        </h4>

                        <p class="text-muted">
                            Safe and trusted payment methods
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100 text-center">

                    <div class="card-body p-4">

                        <i class="bi bi-headset fs-1 text-dark"></i>

                        <h4 class="mt-3">
                            24/7 Support
                        </h4>

                        <p class="text-muted">
                            Our support team is always available
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>
    

</section>

<!-- Categories -->

<section id="category" class="py-5">

    
    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold display-5">
                Shop By Category
            </h2>

            <p class="text-muted">
                Choose your favorite collection
            </p>

        </div>

        <div class="row g-4">

            <!-- Women -->

            <div class="col-lg-4">

                <div class="card category-card border-0 shadow-sm h-100">

                    <img src="images/modelwoman.jpg"
                         class="card-img-top category-image" />

                    <div class="card-body">

                        <span class="badge bg-danger mb-2">
                            2500+ Products
                        </span>

                        <h3 class="fw-bold">
                            Women Collection
                        </h3>

                        <p class="text-muted">
                            Dresses, Tops, Skirts, Jeans and more.
                        </p>

                        <button class="btn btn-dark w-100"
                                @onclick='() => GoToMainProducts(1)'>

                            Shop Women

                        </button>

                    </div>

                </div>

            </div>

            <!-- Men -->

            <div class="col-lg-4">

                <div class="card category-card border-0 shadow-sm h-100">

                    <img src="images/modelwoman.jpg"
                         class="card-img-top category-image" />

                    <div class="card-body">

                        <span class="badge bg-primary mb-2">
                            1500+ Products
                        </span>

                        <h3 class="fw-bold">
                            Men Collection
                        </h3>

                        <p class="text-muted">
                            Shirts, T-Shirts, Jeans and Jackets.
                        </p>

                        <button class="btn btn-dark w-100"
                                @onclick='() => GoToMainProducts(2)'>

                            Shop Men

                        </button>

                    </div>

                </div>

            </div>

            <!-- Kids -->

            <div class="col-lg-4">

                <div class="card category-card border-0 shadow-sm h-100">

                    <img src="images/modelwoman.jpg"
                         class="card-img-top category-image" />

                    <div class="card-body">

                        <span class="badge bg-success mb-2">
                            3000+ Products
                        </span>

                        <h3 class="fw-bold">
                            Kids Collection
                        </h3>

                        <p class="text-muted">
                            Fashion and accessories for kids.
                        </p>

                        <button class="btn btn-dark w-100"
                                @onclick='() => GoToMainProducts(3)'>

                            Shop Kids

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>
    

</section>

<!-- Banner -->

<section class="py-5 bg-dark text-white">

    
    <div class="container text-center">

        <h2 class="display-5 fw-bold">
            Summer Sale Up To 50% Off
        </h2>

        <p class="lead">
            Limited time offer on selected products
        </p>

        <button class="btn btn-light btn-lg mt-3"
                @onclick="GoToCategories">

            Shop Now

        </button>

    </div>
    

</section>

@code {

void GoToCategories()
    {
        Nav.NavigateTo("/#category");
    }

    void GoToMainProducts(int id)
    {
        Nav.NavigateTo($"/productsmain/{id}");
    }


}
