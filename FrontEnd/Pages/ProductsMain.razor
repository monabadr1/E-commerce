@page "/productsmain/{mainCategoryId:int}"

@using Shared
@using FrontEnd.Consumer

@inject ProductConsumer productConsumer
@inject NavigationManager Nav

<div class="container py-5">

    
    <div class="text-center mb-5">

        <h1 class="fw-bold display-5">
            Our Products
        </h1>

        <p class="text-muted">
            Discover the latest fashion collection
        </p>

    </div>

    @if (products == null)
    {
        <div class="text-center py-5">

            <div class="spinner-border text-dark"></div>

            <p class="mt-3 text-muted">
                Loading products...
            </p>

        </div>
    }
    else if (!products.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5">

            <i class="bi bi-bag-x fs-1 text-muted"></i>

            <h3 class="mt-3">
                No Products Found
            </h3>

            <p class="text-muted">
                There are currently no products in this category.
            </p>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in products)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">

                    <div class="card product-card border-0 shadow-sm h-100"
                         @onclick="() => GoToDetails(item.ProductId)">

                        <div class="overflow-hidden">

                            <img src="@(item.Images?.FirstOrDefault() ?? "images/no-image.png")"
                                 class="card-img-top product-image" />

                        </div>

                        <div class="card-body d-flex flex-column">

                            <h5 class="fw-semibold product-title">
                                @item.Name
                            </h5>

                            <div class="mt-auto">

                                <h4 class="fw-bold text-dark">
                                    @item.Price EGP
                                </h4>

                                <button class="btn btn-dark w-100 mt-3">

                                    <i class="bi bi-eye me-2"></i>

                                    View Details

                                </button>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    

</div>

@code {


[Parameter]
    public int mainCategoryId { get; set; }

    List<ProductDto>? products;

    protected override async Task OnParametersSetAsync()
    {
        products =
        await productConsumer
        .GetProductsByMainCategoryAsync(mainCategoryId);
    }

    void GoToDetails(int id)
    {
        Nav.NavigateTo($"/productdetails/{id}");
    }

}
