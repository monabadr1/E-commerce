@page "/register"

@using FrontEnd.Consumer
@using FrontEnd.Service
@using Shared
@inject AuthConsumer AuthConsumer
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject CartStateService CartState
@inject CartConsumer CartConsumer
@inject FavoriteStateService FavoriteStateService
@inject WishListConsumer WishListConsumer

<div class="login-container">
    <div class="login-card">
        <h2>Create Account</h2>
        <EditForm Model="@model" OnValidSubmit="sign_up">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger small mb-3 p-0 list-unstyled" />

            <InputText @bind-Value="model.Name" class="form-control mb-3" placeholder="Full Name" />
            <InputText @bind-Value="model.Email" class="form-control mb-3" placeholder="Email" type="email" />
            <InputText @bind-Value="model.Phone" class="form-control mb-3" placeholder="Phone Number" />

            <!-- Password Field -->
            <!-- Password Field -->
            <div class="password-wrapper mb-3">
                <InputText @bind-Value="model.Password"
                           type="@(showPassword ? "text" : "password")"
                           class="form-control"
                           placeholder="Password" />
                <span class="password-toggle-icon" @onclick="() => showPassword = !showPassword">
                    <i class="@(showPassword ? "bi bi-eye-slash" : "bi bi-eye")"></i>
                </span>
            </div>

            <!-- Confirm Password Field -->
            <div class="password-wrapper mb-3">
                <InputText @bind-Value="model.Confirmpassword"
                           type="@(showConfirmPassword ? "text" : "password")"
                           class="form-control"
                           placeholder="Confirm Password" />
                <span class="password-toggle-icon" @onclick="() => showConfirmPassword = !showConfirmPassword">
                    <i class="@(showConfirmPassword ? "bi bi-eye-slash" : "bi bi-eye")"></i>
                </span>
            </div>

            <button type="submit" class="fw-bold mt-2">Register</button>
        </EditForm>

        <p class="mt-3 text-center small text-muted">
            Already have an account? <a href="/account" class="text-theme fw-bold text-decoration-none">Login</a>
        </p>
    </div>
</div>

@code {
    RegisterDto model = new();

    bool showPassword = false;
    bool showConfirmPassword = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity is not null && authState.User.Identity.IsAuthenticated)
        {
            Nav.NavigateTo("/profile");
        }
    }

    async Task sign_up()
    {
        var result = await AuthConsumer.RegisterAsync(model);
        if (result is not null && !string.IsNullOrEmpty(result.Token))
        {
            await ((CustomAuthStateProvider)AuthStateProvider).MarkUserAsAuthenticate(result.Token);

            // --- 1. دمج محتويات السلة المحلية مع حساب السيرفر ---
            var localCart = await CartState.GetCartAsync();
            if (localCart != null && localCart.Any())
            {
                foreach (var item in localCart)
                {
                    await CartConsumer.AddToCartAsync(item.ProductVariantId, item.Quantity
                    );
                }
                await CartState.ClearCartAsync(); 
            }

            var localFavs = await FavoriteStateService.GetFavoriteAsync();
            if (localFavs != null && localFavs.Any())
            {
                foreach (var item in localFavs)
                {
                    await WishListConsumer.AddWishListAsync(item.ProductId);
                }
                await FavoriteStateService.ClearFavoriteAsync(); // تفريغ المفضلة المحلية
            }

            Nav.NavigateTo("/profile");
        }
    }
}