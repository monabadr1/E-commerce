@page "/categories/{mainCategoryId:int}"

@using Shared
@using FrontEnd.Consumer

@inject ProductConsumer productConsumer
@inject NavigationManager Nav

<div class="container py-5">
    <h2 class="fw-bold mb-4 text-theme page-main-title">Products</h2>

    @if (products == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border custom-spinner"></div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in products)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card product-card border-0 shadow-sm h-100 overflow-hidden" @onclick='() => GoToDetails(item.ProductId)'>
                        <div class="position-relative">
                            <img src="@item.Images.FirstOrDefault()" class="card-img-top product-image" style="object-fit:cover;" />
                        </div>
                        <div class="card-body d-flex flex-column justify-content-between p-3">
                            <h5 class="fw-semibold text-theme mb-2">@item.Name</h5>
                            <button class="btn btn-theme w-100 btn-sm py-2">View Details</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public int mainCategoryId { get; set; }

    List<ProductDto>? products;

    protected override async Task OnInitializedAsync()
    {
        products = await productConsumer.GetproductByCategoryIdAsync(mainCategoryId);
    }

    void GoToDetails(int productId)
    {
        Nav.NavigateTo($"/productdetails/{productId}");
    }
}